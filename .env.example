# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy file này thành .env và điền các API key / thông số của bạn:
# cp .env.example .env
# ==============================================================================

# 1. Google Gemini API (Dùng cho module AI_suggest)
# Hỗ trợ nhiều key cách nhau bằng dấu phẩy để hệ thống tự động xoay tua khi hết quota
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. SerpApi (Dùng cho module data_processing/crawl_fb_post_by_serp)
SERP_API_KEYS=your_serp_key_1,your_serp_key_2

# 3. Bright Data (Dùng cho module data_processing/crawl_fb_comment_by_bright_data)
# Hỗ trợ danh sách nhiều API keys cách nhau bằng dấu phẩy để tự động xoay tua key
BRIGHT_DATA_API_KEYS=your_bright_data_api_key_1,your_bright_data_api_key_2
BRIGHT_DATA_DATASET_ID=gd_lkay758p1eanlolqw8

# 4. FastAPI & Flask Service Ports
API_HOST=0.0.0.0
API_PORT=8000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
